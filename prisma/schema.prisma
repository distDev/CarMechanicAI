generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum ProblemStatus {
  NEW
  DIAGNOSING
  REPAIRING
  RESOLVED
  CLOSED
}

enum DiagnosisSessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum RepairSessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum StepType {
  DIAGNOSIS
  REPAIR
}

enum StepResultStatus {
  PENDING
  DONE
  FAILED
}

enum SessionType {
  DIAGNOSIS
  REPAIR
}

enum StepPartStatus {
  REQUIRED
  ORDERED
  INSTALLED
  SKIPPED
}

enum EntityType {
  PROBLEM
  DIAGNOSIS_SESSION
  REPAIR_SESSION
  VEHICLE
  DIAGNOSIS_STEP

  // Оставляем временно для совместимости со старой схемой.
  CAUSE
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum DiagnosisAttemptStatus {
  IN_PROGRESS
  CONFIRMED
  RULED_OUT
  INCONCLUSIVE
  FAILED
  CANCELED
}

enum DiagnosisStepResponseType {
  CHOICE
  NUMBER
  TEXT
}

enum DiagnosisStepResult {
  FOUND
  NOT_FOUND
  UNCERTAIN
  SKIPPED
}

enum DiagnosisStepSkipReason {
  NO_TOOL
  USER_SKIPPED
}

//
// USERS
//

model User {
  id String @id @default(uuid()) @db.Uuid

  email String? @unique @db.VarChar(255)

  isAnonymous Boolean @default(true) @map("is_anonymous")

  googleId String? @unique @map("google_id")

  name String? @db.VarChar(255)

  avatarUrl String? @map("avatar_url")

  subscriptionTier SubscriptionTier @default(FREE) @map("subscription_tier")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicles Vehicle[]

  conversations ChatConversation[]

  deviceSessions DeviceSession[]

  subscriptions Subscription[]

  aiUsages AiUsage[]

  @@index([isAnonymous])
  @@index([subscriptionTier])
  @@map("users")
}

//
// DEVICE SECCIONS
//

model DeviceSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  deviceId String @map("device_id") @db.VarChar(255)

  platform String? @db.VarChar(50)

  refreshTokenHash String @map("refresh_token_hash")

  userAgent String? @map("user_agent")

  ipAddress String? @map("ip_address")

  expiresAt DateTime @map("expires_at")

  lastActiveAt DateTime @default(now()) @map("last_active_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@map("device_sessions")
}

//
// SUBSCRIPTIONS
//

model Subscription {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  provider String @db.VarChar(50)

  providerSubscriptionId String @map("provider_subscription_id")

  tier SubscriptionTier

  isActive Boolean @default(true) @map("is_active")

  startedAt DateTime @map("started_at")

  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubscriptionId])
  @@index([userId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("subscriptions")
}

//
// VEHICLES
//

model Vehicle {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  brand     String  @db.VarChar(100)
  model     String  @db.VarChar(100)
  modelSpec String? @map("model_spec") @db.VarChar(120)

  year Int?

  engine       String? @db.VarChar(120)
  transmission String? @db.VarChar(120)
  drivetrain   String? @db.VarChar(120)

  mileage Int?

  vin String? @unique @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problems Problem[]

  @@index([userId])
  @@map("vehicles")
}

//
// PROBLEM
//

model Problem {
  id        String @id @default(uuid()) @db.Uuid
  vehicleId String @map("vehicle_id") @db.Uuid

  description String  @db.Text
  errorCode   String? @map("error_code") @db.VarChar(64)

  aiSummary String? @map("ai_summary") @db.Text

  status ProblemStatus @default(NEW)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  photos ProblemPhoto[]

  diagnosisSessions DiagnosisSession[]
  repairSessions    RepairSession[]

  @@index([vehicleId])
  @@index([status])
  @@map("problems")
}

//
// PROBLEM PHOTO 
//

model ProblemPhoto {
  id String @id @default(uuid()) @db.Uuid

  problemId String @map("problem_id") @db.Uuid

  path String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@map("problem_photos")
}

//
// DIAGNOSIS SESSIONS
//

model DiagnosisSession {
  id        String @id @default(uuid()) @db.Uuid
  problemId String @map("problem_id") @db.Uuid

  status DiagnosisSessionStatus @default(PENDING)

  summary          String? @db.Text
  estimatedMinutes Int?    @map("estimated_minutes")

  rawAiResponse   Json? @map("raw_ai_response")
  repairPreview   Json? @map("repair_preview")
  contextSnapshot Json? @map("context_snapshot")

  previousSessionId String? @map("previous_session_id") @db.Uuid

  aiProvider    String? @map("ai_provider") @db.VarChar(50)
  aiModel       String? @map("ai_model") @db.VarChar(100)
  promptVersion String? @map("prompt_version") @db.VarChar(50)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  previousSession DiagnosisSession? @relation("DiagnosisSessionHistory", fields: [previousSessionId], references: [id], onDelete: SetNull)

  nextSessions DiagnosisSession[] @relation("DiagnosisSessionHistory")

  causes DiagnosisCause[]

  @@index([problemId, createdAt])
  @@index([status])
  @@index([previousSessionId])
  @@map("diagnosis_sessions")
}

//
// CAUSES
//

model DiagnosisCause {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid

  name        String  @db.VarChar(255)
  description String? @db.Text

  probability      Float?
  estimatedMinutes Int?   @map("estimated_minutes")

  sortOrder Int @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session DiagnosisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  attempts DiagnosisAttempt[]

  @@unique([sessionId, sortOrder])
  @@map("diagnosis_causes")
}

// 
// DiagnosisAttempt
//
model DiagnosisAttempt {
  id      String @id @default(uuid()) @db.Uuid
  causeId String @map("cause_id") @db.Uuid

  status DiagnosisAttemptStatus @default(IN_PROGRESS)

  resultSummary String? @map("result_summary") @db.Text

  rawAiResponse Json? @map("raw_ai_response")

  aiProvider    String? @map("ai_provider") @db.VarChar(50)
  aiModel       String? @map("ai_model") @db.VarChar(100)
  promptVersion String? @map("prompt_version") @db.VarChar(50)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  cause DiagnosisCause @relation(fields: [causeId], references: [id], onDelete: Cascade)

  steps DiagnosisStep[]

  repairSessionCauses RepairSessionCause[]

  @@index([causeId])
  @@index([status])
  @@map("diagnosis_attempts")
}

//
// DiagnosisStep
//

model DiagnosisStep {
  id        String @id @default(uuid()) @db.Uuid
  attemptId String @map("attempt_id") @db.Uuid

  position Int

  title       String  @db.VarChar(255)
  instruction String  @db.Text
  question    String? @db.Text

  responseType DiagnosisStepResponseType @map("response_type")

  options     Json?
  inputConfig Json? @map("input_config")

  requiredTools String[] @default([]) @map("required_tools")

  safetyNote String? @map("safety_note") @db.Text

  result     DiagnosisStepResult?
  answer     Json?
  comment    String?                  @db.Text
  skipReason DiagnosisStepSkipReason? @map("skip_reason")

  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attempt DiagnosisAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, position])
  @@map("diagnosis_steps")
}

//
// STEPS
//

model Step {
  id String @id @default(uuid()) @db.Uuid

  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id") @db.Uuid

  type StepType

  title       String  @db.VarChar(255)
  description String? @db.Text

  position Int

  content Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stepResults StepResult[]
  parts       StepPart[]

  @@unique([entityType, entityId, position])
  @@index([entityType, entityId])
  @@index([type])
  @@map("steps")
}

//
// STEP RESULTS
//

model StepResult {
  id String @id @default(uuid()) @db.Uuid

  stepId String @map("step_id") @db.Uuid

  sessionType SessionType @map("session_type")
  sessionId   String      @map("session_id") @db.Uuid

  status StepResultStatus @default(PENDING)

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([sessionType, sessionId])
  @@index([status])
  @@map("step_results")
}

//
// REPAIR SESSIONS
//

model RepairSession {
  id        String @id @default(uuid()) @db.Uuid
  problemId String @map("problem_id") @db.Uuid

  status RepairSessionStatus @default(PENDING)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  causes RepairSessionCause[]

  @@index([problemId])
  @@index([status])
  @@map("repair_sessions")
}

//
// RepairSessionCause
//

model RepairSessionCause {
  repairSessionId    String @map("repair_session_id") @db.Uuid
  diagnosisAttemptId String @map("diagnosis_attempt_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  repairSession RepairSession @relation(fields: [repairSessionId], references: [id], onDelete: Cascade)

  diagnosisAttempt DiagnosisAttempt @relation(fields: [diagnosisAttemptId], references: [id], onDelete: Restrict)

  @@id([repairSessionId, diagnosisAttemptId])
  @@index([diagnosisAttemptId])
  @@map("repair_session_causes")
}

//
// STEP PARTS
//

model StepPart {
  id String @id @default(uuid()) @db.Uuid

  stepId String @map("step_id") @db.Uuid

  name String @db.VarChar(255)

  quantity Int @default(1)

  status StepPartStatus @default(REQUIRED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([status])
  @@map("step_parts")
}

//
// CHAT
//

model ChatConversation {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  entityType EntityType? @map("entity_type")
  entityId   String?     @map("entity_id") @db.Uuid

  title String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages ChatMessage[]

  @@index([userId])
  @@index([entityType, entityId])
  @@map("chat_conversations")
}

model ChatMessage {
  id String @id @default(uuid()) @db.Uuid

  conversationId String @map("conversation_id") @db.Uuid

  role ChatRole

  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chat_messages")
}

//
// AI USAGE 
//

model AiUsage {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  operationType String @map("operation_type")

  model String

  tokens Int

  estimatedCost Float? @map("estimated_cost")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("ai_usages")
}
