generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum ProblemStatus {
  NEW
  DIAGNOSING
  REPAIRING
  RESOLVED
  CLOSED
}

enum DiagnosisSessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum RepairSessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum StepType {
  DIAGNOSIS
  REPAIR
}

enum StepResultStatus {
  PENDING
  DONE
  FAILED
}

enum SessionType {
  DIAGNOSIS
  REPAIR
}

enum StepPartStatus {
  REQUIRED
  ORDERED
  INSTALLED
  SKIPPED
}

enum EntityType {
  PROBLEM
  DIAGNOSIS_SESSION
  REPAIR_SESSION
  VEHICLE
  CAUSE
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

//
// USERS
//

model User {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicles      Vehicle[]
  conversations ChatConversation[]

  @@map("users")
}

//
// VEHICLES
//

model Vehicle {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  brand     String  @db.VarChar(100)
  model     String  @db.VarChar(100)
  modelSpec String? @map("model_spec") @db.VarChar(120)

  year Int?

  engine       String? @db.VarChar(120)
  transmission String? @db.VarChar(120)
  drivetrain   String? @db.VarChar(120)

  mileage Int?

  vin String? @unique @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problems Problem[]

  @@index([userId])
  @@map("vehicles")
}

//
// PROBLEMS
//

model Problem {
  id        String @id @default(uuid()) @db.Uuid
  vehicleId String @map("vehicle_id") @db.Uuid

  description String  @db.Text
  errorCode   String? @map("error_code") @db.VarChar(64)

  aiSummary String? @map("ai_summary") @db.Text

  confirmedCauseId String? @map("confirmed_cause_id") @db.Uuid

  status ProblemStatus @default(NEW)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  causes Cause[]

  confirmedCause Cause? @relation("ProblemConfirmedCause", fields: [confirmedCauseId], references: [id], onDelete: SetNull)

  diagnosisSessions DiagnosisSession[]
  repairSessions    RepairSession[]

  @@index([vehicleId])
  @@index([confirmedCauseId])
  @@index([status])
  @@map("problems")
}

//
// DIAGNOSIS SESSIONS
//

model DiagnosisSession {
  id        String @id @default(uuid()) @db.Uuid
  problemId String @map("problem_id") @db.Uuid

  status DiagnosisSessionStatus @default(PENDING)

  rawAiResponse Json? @map("raw_ai_response")
  repairPreview Json? @map("repair_preview")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  completedAt DateTime? @map("completed_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@index([status])
  @@map("diagnosis_sessions")
}

//
// CAUSES
//

model Cause {
  id        String @id @default(uuid()) @db.Uuid
  problemId String @map("problem_id") @db.Uuid

  name        String  @db.VarChar(255)
  description String? @db.Text

  probability Float?

  aiHint String? @map("ai_hint") @db.Text

  isUserCreated Boolean @default(false) @map("is_user_created")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  confirmedInProblems Problem[] @relation("ProblemConfirmedCause")

  repairSessions RepairSession[]

  @@index([problemId])
  @@map("causes")
}

//
// STEPS
//

model Step {
  id String @id @default(uuid()) @db.Uuid

  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id") @db.Uuid

  type StepType

  title       String  @db.VarChar(255)
  description String? @db.Text

  position Int

  content Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stepResults StepResult[]
  parts       StepPart[]

  @@unique([entityType, entityId, position])
  @@index([entityType, entityId])
  @@index([type])
  @@map("steps")
}

//
// STEP RESULTS
//

model StepResult {
  id String @id @default(uuid()) @db.Uuid

  stepId String @map("step_id") @db.Uuid

  sessionType SessionType @map("session_type")
  sessionId   String      @map("session_id") @db.Uuid

  status StepResultStatus @default(PENDING)

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([sessionType, sessionId])
  @@index([status])
  @@map("step_results")
}

//
// REPAIR SESSIONS
//

model RepairSession {
  id String @id @default(uuid()) @db.Uuid

  problemId String @map("problem_id") @db.Uuid
  causeId   String @map("cause_id") @db.Uuid

  status RepairSessionStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  completedAt DateTime? @map("completed_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  cause Cause @relation(fields: [causeId], references: [id], onDelete: Restrict)

  @@index([problemId])
  @@index([causeId])
  @@index([status])
  @@map("repair_sessions")
}

//
// STEP PARTS
//

model StepPart {
  id String @id @default(uuid()) @db.Uuid

  stepId String @map("step_id") @db.Uuid

  name String @db.VarChar(255)

  quantity Int @default(1)

  status StepPartStatus @default(REQUIRED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([status])
  @@map("step_parts")
}

//
// CHAT
//

model ChatConversation {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  entityType EntityType? @map("entity_type")
  entityId   String?     @map("entity_id") @db.Uuid

  title String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages ChatMessage[]

  @@index([userId])
  @@index([entityType, entityId])
  @@map("chat_conversations")
}

model ChatMessage {
  id String @id @default(uuid()) @db.Uuid

  conversationId String @map("conversation_id") @db.Uuid

  role ChatRole

  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chat_messages")
}
